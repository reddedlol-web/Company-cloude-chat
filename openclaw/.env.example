# Скопируй в ~/.openclaw/.env (или задай в AutoClaw dashboard)
# Не коммить реальные ключи!

# Telegram — токен от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# LLM API (BYO — Bring Your Own key)
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Альтернатива — напрямую OpenAI / Anthropic (смотри docs OpenClaw)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
