# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=sk-or-v1-...

# Access control (comma-separated Telegram user IDs)
ALLOWED_USER_IDS=123456789
ADMIN_USER_IDS=123456789

# Limits
DAILY_QUERY_LIMIT=20
MAX_QUESTION_LENGTH=2000

# Paths
KNOWLEDGE_DIR=./knowledge
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/bot.db

# Models
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
TOP_K_CHUNKS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Onboarding (002-admin-onboarding)
BOT_USERNAME=
INVITE_DEFAULT_DAYS=7
INVITE_DEFAULT_MAX_USES=1

# Analytics (003-admin-analytics)
ANALYTICS_STORE_QUESTIONS=true
ANALYTICS_QUESTION_RETENTION_DAYS=90
ANALYTICS_REPORT_CHAT_ID=
ADMIN_NOTIFY_CHAT_ID=
ANALYTICS_SCHEDULE_ENABLED=true
ANALYTICS_DAILY_CRON=0 18 * * *
ANALYTICS_WEEKLY_CRON=0 9 * * 1
ANALYTICS_REPORT_MAX_LLM_TOKENS=4096
ANALYTICS_SUMMARY_MODEL=
ANALYTICS_OFF_TOPIC_SIMILARITY_THRESHOLD=0.35
ANOMALY_NO_ANSWER_RATIO=0.5
ANOMALY_NO_ANSWER_COUNT=5
ANOMALY_LIMIT_USAGE_RATIO=0.9
ANOMALY_TOKEN_USER_DAILY=10000
ANALYTICS_DASHBOARD_ENABLED=false
ANALYTICS_DASHBOARD_TOKEN=
ANALYTICS_DASHBOARD_PORT=8080

# Boss Free knowledge sync (004-bossfree-kb-sync)
# Required only for: python -m src.cli knowledge sync-bossfree
BOSSFREE_EMAIL=
BOSSFREE_PASSWORD=
BOSSFREE_BASE_URL=https://topix.bossfree.pro/api
BOSSFREE_ORIGIN=https://topix.bossfree.pro
